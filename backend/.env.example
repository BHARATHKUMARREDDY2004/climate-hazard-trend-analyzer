# Storage: "auto" tries MongoDB first and falls back to the embedded TinyDB store.
# Use "mongo" to fail fast when MongoDB is unreachable, or "tinydb" to skip MongoDB.
STORAGE_BACKEND=auto
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=climate_hazards
TINYDB_DIR=data

# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute, per client IP.
RATE_LIMIT_GENERAL=120
RATE_LIMIT_HEAVY=15

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Sent as User-Agent to Open-Meteo and Nominatim (Nominatim requires a contact).
CONTACT_EMAIL=
